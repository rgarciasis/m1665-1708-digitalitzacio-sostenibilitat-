{
  "version": 1,
  "author": "REBOOT · 2n DAW",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ntc-temperature-sensor", "id": "ntc1", "top": -120, "left": -210, "attrs": { "temperature": "35" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 120, "left": -230, "attrs": { "value": "920" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 240, "left": 150, "attrs": { "color": "blue", "label": "Iniciar prova", "bounce": "0" } },
    { "type": "wokwi-led", "id": "ledG", "top": -60, "left": 250, "attrs": { "color": "green", "label": "Apte" } },
    { "type": "wokwi-led", "id": "ledY", "top": -60, "left": 300, "attrs": { "color": "yellow", "label": "En prova" } },
    { "type": "wokwi-led", "id": "ledR", "top": -60, "left": 350, "attrs": { "color": "red", "label": "Diagnosi" } },
    { "type": "wokwi-resistor", "id": "rG", "top": 60, "left": 230, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rY", "top": 60, "left": 280, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rR", "top": 60, "left": 330, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ntc1:VCC", "esp:3V3", "red", [] ],
    [ "ntc1:GND", "esp:GND.1", "black", [] ],
    [ "ntc1:OUT", "esp:34", "orange", [] ],
    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:35", "violet", [] ],
    [ "btn1:1.l", "esp:4", "blue", [] ],
    [ "btn1:2.l", "esp:GND.2", "black", [] ],
    [ "esp:25", "rG:1", "green", [] ],
    [ "rG:2", "ledG:A", "green", [] ],
    [ "ledG:C", "esp:GND.2", "black", [] ],
    [ "esp:26", "rY:1", "gold", [] ],
    [ "rY:2", "ledY:A", "gold", [] ],
    [ "ledY:C", "esp:GND.2", "black", [] ],
    [ "esp:27", "rR:1", "red", [] ],
    [ "rR:2", "ledR:A", "red", [] ],
    [ "ledR:C", "esp:GND.2", "black", [] ]
  ],
  "serialMonitor": { "display": "always", "newline": "lf" },
  "dependencies": {}
}
